auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp

auto eth0:0
iface eth0:0 inet static
    address 10.248.0.91
    netmask 255.255.255.0

auto wg0
iface wg0 inet static
    address $(fw_printenv -n wg_addr)
    netmask 255.255.255.255
    pre-up modprobe wireguard
    pre-up ip link add dev wg0 type wireguard
    pre-up wg set wg0 private-key <(fw_printenv -n wg_privkey) \
      peer $(fw_printenv -n wg_peer_pubkey) \
      endpoint $(fw_printenv -n wg_peer_endpoint) \
      allowed-ips $(fw_printenv -n wg_peer_allowed_ips) \
      persistent-keepalive 25
    up \
      for net in $(fw_printenv -n wg_peer_allowed_ips | tr ',' ' '); do \
        ip route add "$net" dev wg0; \
      done
    post-down ip link del dev wg0
